node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
.DS_Store

# Backend
backend/storage/uploads/
backend/storage/test-uploads/

# Web — the mobile APK is a large build artifact, not source; it needs its
# own hosting (e.g. a GitHub Release asset) once deployed, not a git commit.
web/public/downloads/*.apk

# Mobile (Expo) — android/ios/ are regenerated by `expo prebuild`, but we
# keep hand-edited native config in version control (gradle.properties,
# build.gradle, res/, AndroidManifest.xml) since it carries real fixes
# (aapt2 override, missing color resource, RN gradle-plugin compatibility).
# Only the generated build output/cache is excluded.
mobile/android/**/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/.cxx/
mobile/.expo/
mobile/web-build/
